# ---------------------------------------------------------------------------
# Ananta Universal Commercial Portal — environment configuration (EXAMPLE)
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
# No real credentials, hosts, or tokens belong in this file.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Dev default: SQLite file. For staging/production use PostgreSQL, e.g.
# DATABASE_URL="postgresql://user:password@host:5432/aucp?schema=public"
DATABASE_URL="file:./dev.db"

# --- Authentication ---------------------------------------------------------
# 32+ char random string used to sign session JWTs. Generate a fresh one.
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Session lifetime in hours.
SESSION_TTL_HOURS="12"

# --- Initial admin bootstrap (used only by `npm run db:seed`) ---------------
# Change these immediately after first login. Leave blank to skip bootstrap.
BOOTSTRAP_ADMIN_EMAIL="admin@ananta.com.bd"
BOOTSTRAP_ADMIN_PASSWORD=""

# --- Runtime storage paths --------------------------------------------------
# Where intake/archive/processed job artifacts are written (outside the repo).
STORAGE_ROOT="./var/storage"

# --- External integrations (ALL disabled by default; dry-run only) ----------
# Integration mode: "mock" (default, no external calls) | "dryrun" | "live"
# "live" requires explicit business authorization and real credentials.
INTEGRATION_MODE="mock"

# UCP Sales Contract destination (TBD — API vs browser, see decision Q-SC-11)
UCP_API_BASE_URL=""
UCP_API_TOKEN=""
UCP_BROWSER_URL=""

# Sales Contract worker policy (SRS §E-09 / Q-SC-12): false = save-as-draft
AUTO_SUBMIT="false"
OCR_ENABLED="false"

# Mailbox intake (SRS §5.2) — service account, least privilege. Leave blank in dev.
MAILBOX_IMAP_HOST=""
MAILBOX_IMAP_USER=""
MAILBOX_IMAP_PASS=""
INTAKE_DROP_PATH="./var/intake"

# PDF File Rename: read-only directory with the scanned source PDFs (the apply
# step copies renamed files OUT of here into ./var/storage/pdf-rename/<jobId>/renamed).
# Originals are never modified. Leave blank to disable on-disk apply.
RENAME_INPUT_DIR=""

# --- Portal credentials -----------------------------------------------------
# H&M / Bangladesh Bank / Damco credentials are NEVER stored in the repo.
# Provide them only via a secrets manager in a live deployment.
HM_PORTAL_URL="https://supplierportal.hm.com/home"
BB_PORTAL_URL="https://exp.bb.org.bd/ords/f?p=112:1:::::"
DAMCO_PORTAL_URL="https://booking.damco.com/ShipperPortalWeb/"

# --- Damco Shipper Portal (Booking Correction) ------------------------------
# Credentials are read ONLY by the live adapter path and never logged/returned.
# They stay unused in the default mock/dryrun modes. A live run is additionally
# gated by DAMCO_LIVE_ENABLED and NEVER performs a status-changing confirmation
# automatically — REQUESTED bookings are routed for authorised action.
DAMCO_USERNAME=""
DAMCO_PASSWORD=""
DAMCO_LIVE_ENABLED="false"
DAMCO_DEFAULT_COMPANY="ANANTA GARMENTS LIMITED"
DAMCO_DEFAULT_BUYER="H&M HENNES & MAURITZ GBC AB"

# Booking Correction batch limits + matching policy.
BOOKING_MAX_FILES="25"
BOOKING_MAX_FILE_MB="20"
BOOKING_CONCURRENCY="4"
BOOKING_GROSS_WEIGHT_TOLERANCE_KG="0.5"
