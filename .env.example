# ---------------------------------------------------------------------------
# Ananta Universal Commercial Portal — environment configuration (EXAMPLE)
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
# No real credentials, hosts, or tokens belong in this file.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Dev default: SQLite file. For staging/production use PostgreSQL, e.g.
# DATABASE_URL="postgresql://user:password@host:5432/aucp?schema=public"
DATABASE_URL="file:./dev.db"

# --- Authentication ---------------------------------------------------------
# 32+ char random string used to sign session JWTs. Generate a fresh one.
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Session lifetime in hours.
SESSION_TTL_HOURS="12"

# --- Initial admin bootstrap (used only by `npm run db:seed`) ---------------
# Change these immediately after first login. Leave blank to skip bootstrap.
BOOTSTRAP_ADMIN_EMAIL="admin@ananta.com.bd"
BOOTSTRAP_ADMIN_PASSWORD=""

# --- Runtime storage paths --------------------------------------------------
# Where intake/archive/processed job artifacts are written (outside the repo).
STORAGE_ROOT="./var/storage"

# --- External integrations (ALL disabled by default; dry-run only) ----------
# Integration mode: "mock" (default, no external calls) | "dryrun" | "live"
# "live" requires explicit business authorization and real credentials.
INTEGRATION_MODE="mock"

# UCP Sales Contract destination (TBD — API vs browser, see decision Q-SC-11)
UCP_API_BASE_URL=""
UCP_API_TOKEN=""
UCP_BROWSER_URL=""

# Sales Contract worker policy (SRS §E-09 / Q-SC-12): false = save-as-draft
AUTO_SUBMIT="false"
# OCR for scanned PDFs (PDF File Rename module). When false, scanned copies are
# routed to manual review instead of being read. The <lang>.traineddata lives in
# OCR_TESSDATA_DIR (under var/, git-ignored); downloaded there on first use.
OCR_ENABLED="false"
OCR_LANG="eng"
OCR_TESSDATA_DIR="./var/ocr-tessdata"
OCR_MAX_PAGES="2"

# Mailbox intake (SRS §5.2) — service account, least privilege. Leave blank in dev.
MAILBOX_IMAP_HOST=""
MAILBOX_IMAP_USER=""
MAILBOX_IMAP_PASS=""
INTAKE_DROP_PATH="./var/intake"

# PDF File Rename: read-only directory with the scanned source PDFs (the apply
# step copies renamed files OUT of here into ./var/storage/pdf-rename/<jobId>/renamed).
# Originals are never modified. Leave blank to disable on-disk apply.
RENAME_INPUT_DIR=""

# PDF File Rename — folder workflow. Base directory holding the dedicated
# per-type folders (FCR EXTRACT & RENAME, SHIPPING BILL SOFT COPY, WEEK- 41
# SHIPPING BILL SCAN COPY). Read-only; renamed copies go into the output
# sub-folder of each dedicated folder. Default = the in-repo drop.
PDF_RENAME_ROOT="./PDF File Rename"
PDF_RENAME_OUTPUT_SUBDIR="UCP Renamed"
PDF_RENAME_MAX_FILES="2000"

# --- Portal credentials -----------------------------------------------------
# H&M / Bangladesh Bank / Damco credentials are NEVER stored in the repo.
# Provide them only via a secrets manager in a live deployment.
HM_PORTAL_URL="https://supplierportal.hm.com/home"
BB_PORTAL_URL="https://exp.bb.org.bd/ords/f?p=112:1:::::"
# The single authorised Damco bot entry point (portal dashboard). The bot logs
# in here and navigates the portal UI to search/open bookings — no other portal
# URL or example booking-detail deep link is used or retained.
DAMCO_PORTAL_URL="https://booking.damco.com/ShipperPortalWeb/ViewDashboardAction.action"

# --- Damco Shipper Portal (Booking Correction) ------------------------------
# Credentials are read ONLY by the live adapter path and never logged/returned.
# They stay unused in the default mock/dryrun modes. A live run is additionally
# gated by DAMCO_LIVE_ENABLED and NEVER performs a status-changing confirmation
# automatically — REQUESTED bookings are routed for authorised action.
DAMCO_USERNAME=""
DAMCO_PASSWORD=""
DAMCO_LIVE_ENABLED="false"
# Live runs open a VISIBLE local browser (never headless) launched by the local
# UCP backend. Path to chrome.exe / msedge.exe / brave.exe on this PC.
DAMCO_BROWSER_PATH=""
# Local-only (127.0.0.1) DevTools port UCP uses to drive that one browser window.
DAMCO_CDP_PORT="9333"
# Dedicated browser profile (git-ignored; holds the portal session cookies).
DAMCO_SESSION_DIR="./var/damco-session"
DAMCO_NAV_TIMEOUT_MS="45000"
DAMCO_DEFAULT_COMPANY="ANANTA GARMENTS LIMITED"
DAMCO_DEFAULT_BUYER="H&M HENNES & MAURITZ GBC AB"

# Booking Correction batch limits + matching policy.
BOOKING_MAX_FILES="25"
BOOKING_MAX_FILE_MB="20"
BOOKING_CONCURRENCY="4"
BOOKING_GROSS_WEIGHT_TOLERANCE_KG="0.5"

# --- H&M Sales Contract three-PDF-set workflow (module 1 Oct-2026) ----------
# Path to the user's live Sales Contract workbook. The writer NEVER modifies
# this file — it reads it and copyFile's to a new output path per export.
# Example (dev): HM_SALES_CONTRACT_TEMPLATE_PATH="D:/UCP — REQUIRED DATA & FILES/1. Sales Contract Creation/new-up coming shipment -HM-2015 to 2026(AutoRecovered).xlsx"
HM_SALES_CONTRACT_TEMPLATE_PATH=""
HM_SALES_CONTRACT_MAX_FILE_MB="20"

# --- Customs Invoice Generation (module 3) ----------------------------------
# Folder holding the country-wise `<invoiceNo> <countryCode>.xlsx` templates
# (e.g. "45237 OB.xlsx", "45254 EN.xlsx", "45248 OF-(IT).xlsx"). The writer
# reads from here and copyFile's to a fresh per-download workbook — the source
# files are never modified. Default points at the Oct-2026 drop:
CUSTOMS_INVOICE_TEMPLATE_DIR="D:/oct-2026/automation docs/New folder/3. Customs Invoice Generation/Customs Invoice templates and sample files"
CUSTOMS_INVOICE_MAX_FILE_MB="20"

# --- PDF Combiner -------------------------------------------------------------
# The "Combiner Folders" share holding the document folders referenced by the
# master's SL-0n columns (FCR, EXP, SHIPPING BILL (H&M)-2025, Container, …).
# Read-only; blank = module disabled. Forward-slash UNC paths work on Windows.
# Example: PDF_COMBINER_ROOT="//192.168.10.40/Commercial Export/.../Combiner Folders"
PDF_COMBINER_ROOT=""
# Backend master Excel that seeds UCP's managed "active" copy on first use.
# After seeding UCP works from its own copy under STORAGE_ROOT; this is only
# read to seed. Default = the in-repo drop in docs/.
PDF_COMBINER_MASTER_PATH="./docs/INCENTIV SET COMBINER FORMET FINAL - exp sirial.xlsx"
PDF_COMBINER_MAX_FOLDERS="20"
PDF_COMBINER_MAX_ROWS="1000"
PDF_COMBINER_MAX_INDEXED_FILES="50000"
PDF_COMBINER_MAX_MASTER_MB="10"
